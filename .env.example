# --- Majburiy ---

# Neon PostgreSQL ulanish satri
DATABASE_URL=postgresql://user:password@host/dbname

# Express session siri. Yaratish: openssl rand -base64 32
SESSION_SECRET=

# Mobil API JWT siri. Yaratish: openssl rand -base64 48
# DIQQAT: bu qiymat hech qachon git'ga tushmasligi kerak.
JWT_SECRET=

# Admin paneliga birinchi marta kirish uchun parol (kamida 10 belgi).
# Birinchi muvaffaqiyatli kirishdan keyin hash bazaga yoziladi va
# parolni /api/admin/change-password orqali o'zgartirish mumkin.
ADMIN_PASSWORD=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Vergul bilan ajratilgan admin Telegram ID lari
ADMIN_IDS=
# Webhook siri. Berilmasa SESSION_SECRET dan hosil qilinadi.
TELEGRAM_WEBHOOK_SECRET=

# --- Ixtiyoriy ---

# QR kodlarni imzolash siri. Berilmasa SESSION_SECRET ishlatiladi.
QR_SECRET=

# SMS OTP xizmati (devsms.uz)
DEVSMS_API_KEY=

# Tashqi cron uchun sir. Yaratish: openssl rand -hex 24
# Sozlanmasa POST /api/cron/run 503 qaytaradi va rejalashtirilgan ishlar
# faqat server jarayoni ichida (konteyner uyg'oq bo'lganda) bajariladi.
CRON_SECRET=

# CORS uchun qo'shimcha domenlar (vergul bilan), masalan: https://fitboom.uz
ALLOWED_ORIGINS=

# JWT amal qilish muddati
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=90d

# Stripe (hozircha ishlatilmaydi)
STRIPE_SECRET_KEY=
